  <!-- ═══════════════════════════════════════════════════════════════════
       ★2026-07-15 기구학 체인 정정(사용자 지시)★:
         tool0 ─fixed→ Magbot TCW1(툴체인저) ─fixed→ 2FG7 ─prismatic×2→ fingers
       TCW1 = 마그네틱 툴체인저(유엔디/magbot.kr). 공식 스펙(웹 검증 2026-07-15,
       사용자 실측과 완전 일치): 결합 시 Ø95×86.5mm, 질량 1.162kg(Master 1026g
       + Tool Plate 136g), 가반하중 10kg, 반복정밀도 ±0.05mm. 공개 CAD 부재 →
       스펙 기반 원기둥 프록시(B안). 단독 자산 = assets/magbot_tcw1/ (동일 수치).
       ★TCP가 기존 대비 +86.5mm 전방 이동★ → tcp_offset.yaml·pregrasp 상수는
       sim 실측으로 재확정(placeholder 신뢰 금지 교훈).
       ═══════════════════════════════════════════════════════════════════ -->
  <material name="qc_blue">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>
  <material name="tcw1_dark">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <!-- ★★2026-07-30 툴 체인 5단 정정 (사용자 실측)★★
       실기 체인: UR5e flange → ★tool flange 플레이트(5mm, D105)★ → magbot TCW1(86.5mm)
                 → ★OnRobot QC-RS v3(11.25mm)★ → OnRobot 2FG7(base→pad중점 139.75mm)
       구 URDF는 tool flange와 QC-RS v3가 ★모두 누락★돼 tcp_offset이 16.25mm 짧았다
       (사용자 실측: tool0→그리퍼끝 265mm → 파지중심 = 265 − pad전장45/2 = 242.5mm).
       QC-RS v3 두께는 265mm 총장에서 역산(16.25 − flange 5.00 = 11.25mm).
       ⚠️두 링크 모두 ★시각 전용★(콜리전 없음) — TCW1과 동일 방침. -->
  <link name="tool_flange_plate_link">
    <inertial>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0525" length="0.005"/></geometry>
      <material name="tcw1_dark"/>
    </visual>
  </link>

  <link name="qc_rs_v3_link">
    <inertial>
      <origin xyz="0 0 0.005625" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.005625" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.01125"/></geometry>
      <material name="qc_blue"/>
    </visual>
  </link>

  <link name="tcw1_link">
    <inertial>
      <origin xyz="0 0 0.04325" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00006" iyy="0.00006" izz="0.000056" ixy="0" iyz="0" ixz="0"/>  <!-- ★물리 무시(경량)★ -->
    </inertial>
    <!-- ★2026-07-15 시각 메시 적용(사용자 제공 Magbot OBJ)★: Meshy AI 생성 TCW1 메시.
         메시 검증(정점 파싱): 실린더 축=mesh y, −y=마스터(Ø95 굵음)·+y=툴플레이트
         (반경비 0.66 ≈ 실제 Ø61/Ø95=0.64 — 진짜 TCW1 형상 확인).
         적용: ①비균일 스케일로 AI 타원 단면을 원형 Ø95·축장 86.5mm로 보정
              (mesh x±0.7677·z±1.0 → Ø95, y±0.4915 → 86.5mm)
              scale=(0.095/1.5354, 0.0865/0.9830, 0.095/2.0)=(0.06188,0.08800,0.04750)
         ②Rx90°(rpy 1.5708)로 mesh y축→URDF z축(공구축), −y(마스터)→z=0(플랜지측)
         ③origin z=+0.04325로 z∈[0,0.0865] 정렬(콜라이더·조인트 오프셋과 일치).
         ⚠️ 텍스처 PNG 부재(map_Kd) — 무텍스처 렌더(depth 정책 무영향). 시각 전용. -->
    <visual>
      <origin xyz="0 0 0.04325" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="../magbot_tcw1/magbot_tcw1_visual.obj" scale="0.06188 0.08800 0.04750"/>
      </geometry>
      <material name="tcw1_dark"/>
    </visual>
    <!-- 콜라이더 = 원기둥 프리미티브(쿠킹 없음·확실 접촉 — 2026-07-10 교훈). AI 메시는
         비볼록이라 콜라이더 부적합 → 시각만 메시, 충돌은 Ø95×86.5 실린더(시각 envelope 일치). -->
    <!-- ★충돌 없음(사용자 지시: 크기만 유지, 물리 특성 무시)★ — TCW1은 시각 전용 -->
  </link>

  <joint name="tool0_to_flange_plate" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="tool0"/>
    <child link="tool_flange_plate_link"/>
  </joint>

  <!-- tool flange 플레이트 두께 5mm 위에 TCW1이 올라간다 -->
  <joint name="flange_plate_to_tcw1" type="fixed">
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
    <parent link="tool_flange_plate_link"/>
    <child link="tcw1_link"/>
  </joint>

  <!-- TCW1 툴측 플레이트 면(+z 86.5mm)에 QC-RS v3(로봇측 퀵체인저)가 결합 -->
  <joint name="tcw1_to_qc" type="fixed">
    <origin xyz="0 0 0.0865" rpy="0 0 0"/>
    <parent link="tcw1_link"/>
    <child link="qc_rs_v3_link"/>
  </joint>

  <!-- 2FG7 베이스는 QC-RS v3 상면(+z 11.25mm)에 결합 -->
  <joint name="tcw1_to_gripper" type="fixed">
    <origin xyz="0 0 0.01125" rpy="0 0 0"/>
    <parent link="qc_rs_v3_link"/>
    <child link="onrobot_base_link"/>
  </joint>

  <!-- ═══ D435i 브라켓(qc_plate_base_stick_realsense, 사용자 Onshape 제작) ═══
       ★2026-07-15 장착 위치 정정(사용자 — Real_Environment 실사진)★: 브라켓은
       ★TCW1 '이전'의 플랜지(tool0)에 장착★ — TCW1의 형제, 2FG7 체인 밖.
       중앙 Ø75 보어 = ★UR5e 손목(wrist_3) 외경 75mm★를 감싸는 칼라(스택 0 추가).
       플레이트는 플랜지 면 위쪽(z_tool0 -25~0mm)에서 손목을 감싸고, 반경방향
       스틱(-x_b) 끝의 14.46° 웨지면에 카메라 후면(M3×2, 45mm — Intel 337029-005
       p.106) 장착. OBJ 원점 = 보어 중심·플레이트 하면, 단위 meters(Onshape).
       장착 방향: 스틱(-x_b)이 tool0 -y를 향하도록 z축 +90° (rpy 0 0 1.5708).
       질량 0.08kg 추정(PLA). ⚠️ z 오프셋(-0.025)은 실사진 근사 — 시각 전용이라
       카메라 포즈(hand_eye, 사용자 GUI 배치)에는 영향 없음. -->
  <material name="bracket_gray">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>

  <link name="d435i_bracket_link">
    <inertial>
      <origin xyz="-0.010 0 0.009" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000108" iyy="0.000094" izz="0.000194" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../d435i/D435i_Bracket.obj"/>
      </geometry>
      <material name="bracket_gray"/>
    </visual>
    <!-- 충돌 형상 없음(얇은 플레이트 — 그리퍼 외피 내부, 실효 미미) -->
  </link>

  <joint name="tool0_to_bracket" type="fixed">
    <origin xyz="0.0 0.0 0.002044" rpy="3.141587 -0.000147 1.521688"/>
    <parent link="tool0"/>
    <child link="d435i_bracket_link"/>
  </joint>

  <!-- ═══ D435i 카메라 본체 (시각 전용 — depth 센서 자체는 sim에서 TiledCamera
       프림이 hand_eye.yaml로 별도 부착; 이 링크는 본체 형상+질량 72g) ═══
       링크 프레임 = ★optical 관례(z=광축 전방, x=이미지 우, y=이미지 하)★ —
       hand_eye.yaml T_flange_cam과 같은 관례. 브라켓 웨지면 실해석(면 법선
       (0.25,0,0.97) = 수렴각 14.446°) 기반 공칭.
       ★v2(2026-07-15 사용자 GUI 피드백 "더 앞쪽")★: 장착점을 웨지면 중앙 →
       스틱 끝단으로 이동(면 접선 (-0.968,0,-0.249) 방향 17.5mm) — 본체가
       끝단 밖으로 반몸(12.5mm) 오버행해 플레이트에 파묻히지 않음.
         브라켓 프레임 광학중심: (-0.0748, 0, 0.0328)  [v1: (-0.05725,0,0.03905)]
         tool0 프레임 광학중심: (0, -0.0748, +0.1193), 광축이 공구축을
         z≈0.410(=TCP 0.226 + 0.18)에서 교차 — 파지 접근 주시(렌더 검증 대상).
       회전 불변: R = Ry(14.446°)·Rz(-90°) → rpy(-0.25216, 0, -1.5707963). -->
  <link name="d435i_camera_link">
    <inertial>
      <origin xyz="0 0 -0.0125" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia ixx="0.0000075" iyy="0.0000524" izz="0.0000524" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <!-- ★visual 없음(2026-07-15 v3 — 사용자 GUI 배치 워크플로)★: 본체 시각은 USD에
         굽지 않고 sim 런타임이 hand_eye.yaml 포즈로 부착(scene.make_d435i_body_cfg)
         — 배치 반복 시 URDF 재변환 불필요 + GUI 고스트 배치와 중복 표시 없음.
         이 링크는 질량(72g)·프레임 정의용으로만 유지. 충돌 형상 없음(시각 전용). -->
  </link>

  <!-- ★v4(2026-07-15 브라켓 플랜지 장착 정정 후 사용자 GUI 재배치)★: place_d435i_gui.py
       고스트 좌표를 optical 관례로 변환·직교화 후 브라켓(tool0 자식) 프레임으로 역산
       (hand_eye.yaml과 동일 소스). 이 링크는 질량(72g) 전용 — 본체 시각은 sim
       런타임 부착(hand_eye 단일 소스). -->
  <joint name="bracket_to_camera" type="fixed">
    <origin xyz="-0.06984 0.00227 -0.01639" rpy="-1.860088 0.008382 -1.648608"/>
    <parent link="d435i_bracket_link"/>
    <child link="d435i_camera_link"/>
  </joint>


  <material name="gripper_silver">
    <color rgba="0.7 0.7 0.72 1.0"/>
  </material>

  <!-- ── base_link: 그리퍼 몸체(툴 플랜지에 결합될 루트) ── -->
  <link name="onrobot_base_link">
    <inertial>
      <origin xyz="-4.898915958379213e-05 2.84756960271082e-06 0.06811082379774974" rpy="0 0 0"/>
      <mass value="1.2646523179240972"/>
      <inertia ixx="0.001504" iyy="0.001812" izz="0.001053" ixy="-0.0" iyz="0.0" ixz="-3e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/onrobot_2fg7/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gripper_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/onrobot_2fg7/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ── right_finger_link ── -->
  <link name="right_finger_link">
    <inertial>
      <origin xyz="0.017874296677847158 0.02949104051991925 0.01523421548622829" rpy="0 0 0"/>
      <mass value="0.023219383355922288"/>
      <inertia ixx="6e-06" iyy="5e-06" izz="2e-06" ixy="-0.0" iyz="-0.0" ixz="1e-06"/>
    </inertial>
    <!-- ★2026-08-10(P10) 비주얼도 콜리전(10mm)에 맞춰 x방향 압축★ (사용자 결정)
         STL 원본 두께 19.2mm → x 스케일 0.001×(10/19.2)=0.000520833 로 10mm.
         origin x는 압축 후 메시가 콜리전 박스와 ★정확히 겹치도록★ 재계산했다.
         y·z는 불변(원래부터 콜리전과 일치). ⇒ 렌더 = 물리 = 도면(바깥 폭 94/54mm). -->
    <visual>
      <origin xyz="0.043675 0.029494 -0.12005" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/onrobot_2fg7/right_finger_link.stl" scale="0.000520833 0.001 0.001"/>
      </geometry>
      <material name="gripper_silver"/>
    </visual>
    <!-- ★2026-07-10 파지 콜라이더 = 박스 프리미티브★: convex_hull/decomposition 메시 콜라이더가
         큐브에 유효 접촉을 못 만들어(파고들어도 힘~0, 포렌식 확정) 그립 실패. 프리미티브 박스는
         PhysX 네이티브(쿠킹 없음) → 확실한 접촉 + 평면 pad = 평행 그리퍼 접촉면에 이상적.
         크기·중심 = 원래 finger mesh bound(19.2×32×45mm, pad 중심=link frame). measure_grasp_frame 근거. -->
    <!-- ★2026-08-10(P10) 핑거팁 두께 정정 19.2mm → ★실물 10mm★ (CAD 2fg7.png + 사용자 확인)★
         구 값은 finger STL bound(19.2mm)를 그대로 콜라이더로 쓴 것인데, 실물 팁 두께는 10mm다.
         그 결과 완전 개방 시 핑거 바깥 폭이 112.4mm로 ★하우징 90mm를 편측 11.2mm 초과★해
         정리 전 현장 진단 화면에서 핑거가 몸체 밖으로 튀어나왔다(원본은 Git history에 보존).
         ★안쪽 파지면은 고정★하고 바깥으로만 얇게 만든다 — 안쪽 간격 74/50/34mm 불변,
         편측 침투 8.0mm 불변(두께 10mm 안이라 관통 없음), 접촉력 24N 불변. 파지 물리 무변경.
         ⚠️구 주석의 'CAD 실제 두께 5mm' 는 도면 오독이었다(34→44 / 74→84 는 두께가 아니라
           ★팁 장착 위치 2종★이다). 5mm였다면 침투 8mm가 두께를 넘어 관통했겠지만 10mm는 안전하다. -->
    <collision>
      <origin xyz="0.02706 0.029494 0.01970" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.032 0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- ── left_finger_link ── -->
  <link name="left_finger_link">
    <inertial>
      <origin xyz="0.004247703322119739 0.029496959480080673 0.015234215486237948" rpy="0 0 0"/>
      <mass value="0.023219383355922288"/>
      <inertia ixx="6e-06" iyy="5e-06" izz="2e-06" ixy="-0.0" iyz="0.0" ixz="-1e-06"/>
    </inertial>
    <!-- ★2026-08-10(P10) 비주얼도 콜리전(10mm)에 맞춰 x방향 압축★ (사용자 결정)
         STL 원본 두께 19.2mm → x 스케일 0.001×(10/19.2)=0.000520833 로 10mm.
         origin x는 압축 후 메시가 콜리전 박스와 ★정확히 겹치도록★ 재계산했다.
         y·z는 불변(원래부터 콜리전과 일치). ⇒ 렌더 = 물리 = 도면(바깥 폭 94/54mm). -->
    <visual>
      <origin xyz="-0.021555 0.029494 -0.12005" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/onrobot_2fg7/left_finger_link.stl" scale="0.000520833 0.001 0.001"/>
      </geometry>
      <material name="gripper_silver"/>
    </visual>
    <!-- ★2026-07-10 파지 콜라이더 = 박스 프리미티브★ (right_finger_link와 동일 근거). -->
    <!-- ★2026-08-10(P10) 핑거팁 두께 정정 19.2mm → ★실물 10mm★ (CAD 2fg7.png + 사용자 확인)★
         구 값은 finger STL bound(19.2mm)를 그대로 콜라이더로 쓴 것인데, 실물 팁 두께는 10mm다.
         그 결과 완전 개방 시 핑거 바깥 폭이 112.4mm로 ★하우징 90mm를 편측 11.2mm 초과★해
         정리 전 현장 진단 화면에서 핑거가 몸체 밖으로 튀어나왔다(원본은 Git history에 보존).
         ★안쪽 파지면은 고정★하고 바깥으로만 얇게 만든다 — 안쪽 간격 74/50/34mm 불변,
         편측 침투 8.0mm 불변(두께 10mm 안이라 관통 없음), 접촉력 24N 불변. 파지 물리 무변경.
         ⚠️구 주석의 'CAD 실제 두께 5mm' 는 도면 오독이었다(34→44 / 74→84 는 두께가 아니라
           ★팁 장착 위치 2종★이다). 5mm였다면 침투 8mm가 두께를 넘어 관통했겠지만 10mm는 안전하다. -->
    <collision>
      <origin xyz="-0.00494 0.029494 0.01970" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.032 0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- ── 구동 관절: left_finger_joint (q=0 열림 74mm, q=0.020 폐합 명령 34mm) ── -->
  <joint name="left_finger_joint" type="prismatic">
    <!-- ★2026-07-29 핑거팁 바깥 위치 반영(사용자 실측: 최대 열림 80mm / 최소 40mm)★
         구 자산은 안쪽 위치(44.6/6.6mm)라 ★실기 최소 폐합 40mm보다 좁아 3cm 큐브가
         손가락 사이를 통과했고, 5cm 큐브는 아예 안 들어갔다★. joint origin을 바깥으로
         17.70mm 옮겨 열림 80.0mm / 폐합 42.0mm로 맞춘다(스트로크 38mm는 불변).
         ⚠️근사: 실물은 핑거팁만 재장착되지만 STL이 핑거 일체형이라 핑거 전체를 옮긴다 —
           파지면·TCP는 정확하고, 핑거 뿌리 쪽 외형에만 오차가 남는다(학습 물리엔 무영향).
         ⚠️tcp_offset은 불변 — 좌우 대칭 이동이라 파지중심(x≈0, z=0.2262)이 보존된다. -->
    <origin xyz="0.046940 -0.029494 0.12005" rpy="0 0 0"/>
    <parent link="onrobot_base_link"/>
    <child link="left_finger_link"/>
    <axis xyz="-1.0 0.0 0.0"/>
    <limit lower="0.0" upper="0.020" effort="140" velocity="0.45"/>
  </joint>

  <!-- ── right_finger_joint: 좌측과 ★독립 구동★, 같은 목표를 받아 대칭 개폐 (F91, 2026-09-20) ──
       ★2026-09-20 F91 정정★: 종전에는 <mimic joint="left_finger_joint" multiplier="1.0"/>였고
       변환 옵션 convert_mimic_joints_to_normal_joints=True로 "독립 2관절"이 된다고 믿었다.
       그러나 Isaac Sim 5.1 변환 결과(USD)는 오른쪽 관절에 ★드라이브 없이★ PhysX mimic API
       (gearing −1, rotX 슬롯, 한계 [−0.004, 0.024])만 남겨 사실상 수동 관절이 됐다 — 왼쪽만 닫히고
       오른쪽은 큐브에 밀려 하한 −4 mm에 걸리는 편측 파지를 teacher가 학습했다(사용자 영상 확인,
       v1 조립기 실측 L 12.6 / R −4.0 mm). 실물 2FG7은 양 손가락이 같은 거리를 대칭으로 움직이므로
       mimic 태그를 제거하고 좌측과 같은 한계 [0, 0.020]로 두어 두 관절을 같은 목표로 구동한다
       (BinaryJointPositionAction이 두 관절에 같은 값을 쓴다 — ur5e_assets.GRIPPER_*_COMMAND). -->
  <joint name="right_finger_joint" type="prismatic">
    <!-- 좌측과 대칭 이동(17.70mm 바깥) — 위 주석 참조. -->
    <origin xyz="-0.069060 -0.029494 0.12005" rpy="0 0 0"/>
    <parent link="onrobot_base_link"/>
    <child link="right_finger_link"/>
    <axis xyz="1.0 0.0 0.0"/>
    <limit lower="0.0" upper="0.020" effort="140" velocity="0.45"/>
  </joint>


</robot>
